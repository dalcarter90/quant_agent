# Copy to .env and fill in. .env is gitignored and must never be committed.
# Credentials come from https://app.alpaca.markets/ -> API keys.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# 1 = paper (default). Set to 0 only to trade real money -- deliberately
# explicit, so live trading is never something you fall into by omission.
ALPACA_PAPER=1

# iex = free feed. sip = paid consolidated tape.
ALPACA_STOCK_FEED=iex
